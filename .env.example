# Copy this file to `.env.local` and fill in the secrets for the features you want to enable.
# Every feature degrades gracefully — missing variables simply disable that feature.
# For example, without GEMINI_API_KEY the AI Assistant widget still renders but replies
# with a friendly "not configured" notice.

# ------------------------------
# AI Assistant (Google Gemini)
# ------------------------------
# Google AI Studio key powering the /api/chat widget
GEMINI_API_KEY=

# ------------------------------
# Now Playing — Apple Music (primary)
# ------------------------------
# Apple Music developer token
APPLE_MUSIC_DEVELOPER_TOKEN=
# Apple Music user (Music-User) token
APPLE_MUSIC_USER_TOKEN=
# Storefront code (e.g. "us"). Defaults to "us" when unset.
APPLE_MUSIC_STOREFRONT=us

# ------------------------------
# Now Playing — Spotify (fallback)
# ------------------------------
# Spotify app client ID and secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Long-lived refresh token — obtain via /api/spotify/auth
SPOTIFY_REFRESH_TOKEN=

# ------------------------------
# Contact form (Resend)
# ------------------------------
# Resend API key for transactional email
RESEND_API_KEY=

# ------------------------------
# Resume gate (Google Drive / Sheets)
# ------------------------------
# Secret used to sign and verify resume-access tokens
RESUME_TOKEN_SECRET=
# Service account email with access to the resume Drive file and logging Sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account private key — keep surrounding quotes so embedded newlines survive
GOOGLE_PRIVATE_KEY=""
# Google Drive file ID for the resume
GOOGLE_RESUME_FILE_ID=
# Google Sheet ID for access logging
GOOGLE_SHEET_ID=
